{
  "realm": "imobiliaria",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "PLATAFORMA_ADMIN",
        "description": "Operador da plataforma — fora do modelo de tenant, provisiona novas imobiliárias (RN-00-06/07)"
      },
      {
        "name": "ADMINISTRADOR",
        "description": "Papel administrativo dentro do tenant — gerencia pessoas, papéis e parâmetros (RN-00-09/10)"
      },
      {
        "name": "USUARIO",
        "description": "Papel operacional dentro do tenant"
      }
    ]
  },
  "clients": [
    {
      "clientId": "imobiliaria-frontend",
      "name": "Frontend Angular",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "http://localhost:4200",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:8080/swagger-ui/oauth2-redirect.html",
        "http://localhost:8088/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": ["http://localhost:4200", "http://localhost:8080", "http://localhost:8088"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin.dev",
      "enabled": true,
      "emailVerified": true,
      "email": "admin.dev@imobiliaria-demo.local",
      "firstName": "Admin",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMINISTRADOR"],
      "attributes": {
        "tenant_id": ["00000000-0000-7000-8000-000000000001"]
      }
    },
    {
      "username": "plataforma.dev",
      "enabled": true,
      "emailVerified": true,
      "email": "plataforma.dev@plataforma.local",
      "firstName": "Plataforma",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["PLATAFORMA_ADMIN"]
    }
  ]
}
